# Copy this file to .env and fill in real values before running examples/send_message.py.
# The script automatically loads .env from the project root.
# The ArkClaw API host is derived by SDK from ARKCLAW_REGION: arkclaw.${ARKCLAW_REGION}.volcengineapi.com

export ARKCLAW_ACCESS_KEY="replace-with-your-access-key"
export ARKCLAW_SECRET_KEY="replace-with-your-secret-key"
export ARKCLAW_REGION="cn-beijing"
export ARKCLAW_SPACE_ID="csi-replace-with-your-space-id"
export ARKCLAW_INSTANCE_ID="ci-replace-with-your-instance-id"

export ARKCLAW_TEST_MESSAGE="Hello from arkclaw-python-sdk. Please reply with one short sentence."
export ARKCLAW_RECEIVE_TIMEOUT="120"
